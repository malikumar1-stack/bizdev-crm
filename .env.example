# ==============================================================================
# Business Development CRM & Meeting Follow-Up System — Environment Template
# Copy this file to .env and configure your variables before running
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Karachi
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local Zero-Setup SQLite Development:
DATABASE_URL="file:./dev.db"

# For Production PostgreSQL (Supabase / Neon / Render / Docker / AWS RDS):
# DATABASE_URL="postgresql://user:password@localhost:5432/bizdevcrm?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Provide a long, secure random string for JWT token generation
JWT_SECRET=replace_with_a_secure_random_secret_string_minimum_32_chars

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# Optional: Can also be configured dynamically in the Admin Settings UI
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=BizDev CRM <crm-notifications@yourdomain.com>

# ------------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
# Optional: If unconfigured, the system automatically provides verified wa.me click-to-chat links
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_KEY=your_meta_whatsapp_cloud_api_bearer_token

# ------------------------------------------------------------------------------
# 6. AI ASSISTANT (GEMINI API)
# ------------------------------------------------------------------------------
# Optional: For AI meeting notes summarization and strategic relationship health insights
GEMINI_API_KEY=your_google_gemini_api_key_here
